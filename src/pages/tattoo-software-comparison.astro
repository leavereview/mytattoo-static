  <!-- CTA Section -->
  <section class="section bg-gradient-to-r from-brand-red to-blood-deep text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Try the Software Built for Tattoo Studios</h2>
      <p class="text-xl mb-8 opacity-90">Reference uploads, deposit-gated bookings, and no per-booking fees — built for the independent tattoo artist. Start taking deposit-secured bookings today.</p>
      <a href="https://app.mytattoo.software/signin" class="btn bg-white text-brand-red hover:bg-gray-100 text-lg px-8 py-4">Get started</a>
      <p class="text-sm mt-4 opacity-75">MyTattoo is deposit-secured booking for independent tattoo artists.</p>
    </div>
  </section>

  <!-- Related Content -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <h2 class="text-2xl font-bold text-brand-navy mb-8 text-center">Related Guides</h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href="/tattoo-studio-software/" class="card p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-bold text-brand-navy mb-2">Studio Software Guide</h3>
          <p class="text-gray-600 text-sm">The complete platform for tattoo shops and studios</p>
        </a>
        <a href="/tattoo-booking-software/" class="card p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-bold text-brand-navy mb-2">Booking Software Guide</h3>
          <p class="text-gray-600 text-sm">Online booking, deposits, and reducing no-shows</p>
        </a>
        <a href="/pricing/" class="card p-6 hover:shadow-lg transition-shadow">
          <h3 class="font-bold text-brand-navy mb-2">Pricing</h3>
          <p class="text-gray-600 text-sm">No platform fee, no per-booking fees</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
