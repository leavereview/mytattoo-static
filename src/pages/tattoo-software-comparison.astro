  { name: 'Vagaro', price: 'From ~£20/mo (1 calendar)', commission: 'None stated', note: '+~$10/mo per extra calendar; add-ons priced separately' },
  { name: 'Fresha', price: '$19.95/mo Independent', commission: '20% on new marketplace clients (min $6)', note: 'Ended its free model in 2025' },
