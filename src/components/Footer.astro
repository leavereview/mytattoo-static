---
const currentYear = new Date().getFullYear();

const footerLinks = {
  software: [
    { label: 'Studio Software', href: '/tattoo-studio-software/' },
    { label: 'Booking Software', href: '/tattoo-booking-software/' },
    { label: 'Scheduling Software', href: '/tattoo-scheduling-software/' },
    { label: 'Booking App', href: '/tattoo-booking-app/' },
    { label: 'Appointment Software', href: '/tattoo-appointment-software/' },
    { label: 'Artist Software', href: '/tattoo-artist-software/' },
    { label: 'Instagram Bookings', href: '/tattoo-bookings-from-instagram/' },
    { label: 'Software Comparison', href: '/tattoo-software-comparison/' },
    { label: 'Booksy Alternative', href: '/booksy-alternative/' },
  ],
  popular: [
    { label: 'Best Tattoo Studio Software', href: '/blog/best-tattoo-studio-software/' },
    { label: 'Best Booking Software', href: '/blog/best-tattoo-booking-software/' },
    { label: 'Tattoo Deposits Guide', href: '/blog/tattoo-deposit-guide/' },
    { label: 'Tattoo Artist Earnings', href: '/blog/how-much-do-tattoo-artists-make/' },
    { label: 'Reduce No-Shows', href: '/blog/reduce-no-shows-tattoo-studio/' },
    { label: 'Flash Booking Guide', href: '/blog/flash-booking-tattoo-artists-guide/' },
  ],
  resources: [
    { label: 'Calculator', href: '/tattoo-studio-calculator/' },
    { label: 'Blog', href: '/blog/' },
    { label: 'Pricing', href: '/pricing/' },
    { label: 'About', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy-policy/' },
    { label: 'Terms of Service', href: '/terms/' },
  ]
};
---

<footer class="bg-brand-navy text-white">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <span class="text-2xl font-bold text-white">MyTattoo<span class="text-brand-red">.Software</span></span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Deposit-secured booking for independent tattoo artists. Turn your Instagram bio link into a reference-attached booking that's confirmed by a deposit.
        </p>
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/johnpowellpm/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Software</h3>
        <ul class="space-y-3">
          {footerLinks.software.map((link) => (<li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Popular Articles</h3>
        <ul class="space-y-3">
          {footerLinks.popular.map((link) => (<li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-3">
          {footerLinks.resources.map((link) => (<li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a></li>))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Get Started</h3>
        <p class="text-gray-400 text-sm mb-4">MyTattoo is deposit-secured booking for independent tattoo artists.</p>
        <a href="https://app.mytattoo.software/signin" class="btn-primary text-sm">Get started</a>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">&copy; {currentYear} MyTattoo.Software. All rights reserved.</p>
      <div class="flex gap-6">
        {footerLinks.legal.map((link) => (<a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.label}</a>))}
      </div>
    </div>
  </div>
</footer>
